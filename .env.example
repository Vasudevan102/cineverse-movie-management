# CineVerse Environment Variables Template (.env.example)
# DO NOT put real production secrets in this file.
# Copy this file to .env and configure values locally or in deployment platform.

DEBUG=False
SECRET_KEY=replace-with-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com

# Database (PostgreSQL / Neon in production, SQLite in local development)
DATABASE_URL=postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cineverse?sslmode=require

# Razorpay Payment Gateway (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
PAYMENT_GATEWAY_MODE=TEST
RAZORPAY_DEMO_MODE=False

# Celery & Redis Background Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email Delivery (SMTP / Gmail App Password or SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=CineVerse <noreply@cineverse.app>